<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProyectoTM.BusquedaEtiquetaPage" Title="Buscar Etiqueta">
    <VerticalStackLayout Padding="20">
        <Entry x:Name="EntradaTag" Placeholder="Etiqueta (ej: montaña)" />
        <Button Text="Filtrar" Clicked="OnFiltrarClicked" />
        <CollectionView x:Name="ListaTags">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Label Text="{Binding Nombre}" TextColor="Purple" FontAttributes="Bold"/>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>