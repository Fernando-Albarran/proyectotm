<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProyectoTM.ModificarDificultadPage" Title="Modificar Dif.">
    <VerticalStackLayout Padding="20" Spacing="15">
        <Entry x:Name="EntradaId" Placeholder="Nombre exacto (ej: bosque)" />
        <Entry x:Name="EntradaDif" Placeholder="Nueva Dificultad (ej: Extrema)" />
        <Button Text="Actualizar" Clicked="OnActualizarClicked" />
    </VerticalStackLayout>
</ContentPage>