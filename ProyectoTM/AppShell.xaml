<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ProyectoTM.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ProyectoTM"
    Title="Rutas"
    FlyoutBehavior="Flyout">

    <Shell.FlyoutHeader>
        <VerticalStackLayout Padding="20" BackgroundColor="#512BD4">
            <Label Text="MENU" TextColor="White" FontAttributes="Bold"/>
        </VerticalStackLayout>
    </Shell.FlyoutHeader>

    <FlyoutItem Title="Gestión Básica">
        <ShellContent Title="Listado de Rutas" ContentTemplate="{DataTemplate local:ListadoRutaPage}" />
        <ShellContent Title="Añadir Ruta" ContentTemplate="{DataTemplate local:AñadirRutaPage}" />
        <ShellContent Title="Eliminar Ruta" ContentTemplate="{DataTemplate local:EliminarRutaPage}" />
        <ShellContent Title="Editar etiqueta Ruta" ContentTemplate="{DataTemplate local:EtiquetaRutaPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Avanzado">
        <ShellContent Title="Estadísticas" ContentTemplate="{DataTemplate local:EstadisticasPage}" />
        <ShellContent Title="Buscar Prov." ContentTemplate="{DataTemplate local:ListadoProvinciaPage}" />
        <ShellContent Title="Buscar Etiq." ContentTemplate="{DataTemplate local:BusquedaEtiquetaPage}" />
        <ShellContent Title="Modificar Dif." ContentTemplate="{DataTemplate local:ModificarDificultadPage}" />
    </FlyoutItem>

</Shell>